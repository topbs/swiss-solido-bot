PORT=3210
API_SECRET=replace_with_random_secret

# Token from BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Bot username without https://t.me/ and without @
TELEGRAM_BOT_USERNAME=SwissSolidoBot

# Optional. Falls back to API_SECRET.
BIND_SECRET=replace_with_another_random_secret

# Optional. Default: 30 days
BIND_TTL_SECONDS=2592000

# Optional path for local bindings storage
DATA_FILE=./data/telegram-bindings.json
